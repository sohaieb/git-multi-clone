{
  "name": "git-multi-clone",
  "version": "1.0.1",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build-win": "bun build --compile --target=bun-windows-x64 ./index.ts --outfile executables/win/gmc.exe",
    "build-linux": "bun build --compile --target=bun-linux-x64 ./index.ts --outfile executables/linux/gmc",
    "build-mac": "bun build --compile --target=bun-darwin-x64 ./index.ts --outfile executables/mac/gmc"

  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  }
}